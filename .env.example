# --- Pick ONE free LLM option (all are OpenAI-compatible) ---
# Option A: Groq free tier (no card needed; check current rate limits)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key
LLM_MODEL=llama-3.3-70b-versatile
# Option B: Google Gemini free tier
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_key
# LLM_MODEL=gemini-2.5-flash
# Option C: Ollama, fully local, $0, no rate limits (ollama pull qwen2.5:14b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# Free models cost $0; set these only if you want a *notional* cost figure (USD per 1M tokens)
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# Optional Langfuse (free Hobby tier). Leave blank to use local JSONL traces only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

API_URL=http://localhost:8000
